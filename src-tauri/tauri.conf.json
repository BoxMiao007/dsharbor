{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSHarbor",
  "version": "0.3.2",
  "identifier": "com.boxmiao.dsharbor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm pack:bridge",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSHarbor",
        "width": 1000,
        "height": 700,
        "minWidth": 960,
        "minHeight": 520,
        "center": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "BoxMiao007",
    "shortDescription": "DSH Web 的轻量桌面壳",
    "resources": ["resources/*.tgz"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
