{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSHarbor",
  "version": "0.9.0",
  "identifier": "com.boxmiao.dsharbor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build && pnpm pack:bridge",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "BoxMiao007",
    "shortDescription": "DSH Web 的轻量桌面壳",
    "resources": ["resources/*.tgz"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
