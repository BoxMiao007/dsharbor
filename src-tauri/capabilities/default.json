{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力：只开放界面真正会调用的权限（三只自绘窗口按钮 + 拖动窗口 + 选文件对话框）。data-tauri-drag-region 属性由 Tauri 注入的脚本调到 start-dragging 命令，仍然需要这条权限。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-open"
  ]
}
